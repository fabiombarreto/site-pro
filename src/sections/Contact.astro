---
import type { CollectionEntry } from 'astro:content';
import { Button } from '../components/page/Button';
import { SectionHeading } from '../components/page/SectionHeading';
import { compileScript, serializeTimeline } from '../runtime/compiler';
import { strings } from '../strings';
import { contactBuild } from './contact.build';
import { profileLinks } from './profile-links';

interface Props {
  profile: CollectionEntry<'profile'>['data'];
}

const { profile } = Astro.props;
const links = profileLinks(profile);
if (!profile.location) throw new Error('profile.location is missing');
const timeline = compileScript(contactBuild(profile));
---

<section
  id="contact"
  aria-labelledby="contact-title"
  class="sp-section sp-contact"
  data-build={serializeTimeline(timeline)}
>
  <div class="sp-section-inner">
    <div class="sp-build-wrap" data-build-target="heading">
      <SectionHeading
        id="contact-title"
        eyebrow={strings.sections.contact.eyebrow}
        title={strings.sections.contact.title}
        lead={strings.sections.contact.lead}
      />
    </div>
    <div class="sp-contact-row">
      <div class="sp-actions" data-build-target="links">
        <Button variant="primary" icon="github" href={links.github} external>
          {strings.buttons.github}
        </Button>
        <Button
          variant="secondary"
          icon="linkedin"
          href={links.linkedin}
          external
        >
          {strings.buttons.linkedin}
        </Button>
      </div>
      <p class="sp-contact-location mono-sm" data-build-target="location">
        {profile.location}
      </p>
    </div>
  </div>
</section>
