---
import type { CollectionEntry } from 'astro:content';
import { Button } from '../components/page/Button';
import { Photo } from '../components/page/Photo';
import {
  PHOTO_SIZES,
  asciiForAsset,
  imageSource,
  photoWidths,
  sourcePathFor,
} from '../images/pipeline';
import { compileScript, serializeTimeline } from '../runtime/compiler';
import { strings } from '../strings';
import { heroBuild } from './hero.build';
import { profileLinks } from './profile-links';

interface Props {
  profile: CollectionEntry<'profile'>['data'];
}

const { profile } = Astro.props;
const links = profileLinks(profile);
const photo = await imageSource(profile.photo, {
  widths: photoWidths(profile.photo),
  sizes: PHOTO_SIZES,
});
const ascii = await asciiForAsset(profile.photo);
const [first = '', ...rest] = profile.headline.split(' ');
const remainder = rest.join(' ');
const photoName = sourcePathFor(profile.photo).split(/[\\/]/).pop();
const timeline = compileScript(heroBuild(profile, photoName));
---

<section
  id="top"
  aria-label={strings.hero.ariaLabel}
  class="sp-hero"
  data-build={serializeTimeline(timeline)}
>
  <div class="sp-hero-inner">
    <h1 class="banner sp-hero-name" data-build-target="title">
      {first} <br />
      {remainder}
    </h1>
    <div
      class="sp-hero-photo"
      data-build-target="photo"
      data-build-ascii={ascii}
    >
      <Photo image={photo} alt={profile.name} priority />
    </div>
    <p class="sp-hero-role text-2xl" data-build-target="role">
      {profile.role}
    </p>
    <div class="sp-hero-copy">
      <p class="text-lg" data-build-target="intro">
        {profile.subtitle}
      </p>
      <div class="sp-hero-actions" data-build-target="links">
        <Button variant="primary" href="#projects" iconEnd="arrowDown">
          {strings.hero.seeMyWork}
        </Button>
        <Button variant="ghost" icon="github" href={links.github} external>
          {strings.buttons.github}
        </Button>
        <Button variant="ghost" icon="linkedin" href={links.linkedin} external>
          {strings.buttons.linkedin}
        </Button>
      </div>
    </div>
  </div>
</section>
