---
import type { CollectionEntry } from 'astro:content';
import { ProjectCard } from '../components/page/ProjectCard';
import { SectionHeading } from '../components/page/SectionHeading';
import {
  COVER_SIZES,
  COVER_WIDTHS,
  blurForAsset,
  imageSource,
} from '../images/pipeline';
import { compileScript, serializeTimeline } from '../runtime/compiler';
import { strings } from '../strings';
import { projectsBuild } from './projects.build';

interface Props {
  projects: CollectionEntry<'projects'>[];
}

const { projects } = Astro.props;
const covers = await Promise.all(
  projects.map(async ({ data }) => {
    if (!data.cover) return { cover: undefined, blur: undefined };
    const [cover, blur] = await Promise.all([
      imageSource(data.cover, { widths: COVER_WIDTHS, sizes: COVER_SIZES }),
      blurForAsset(data.cover),
    ]);
    return { cover, blur };
  }),
);
const timeline = compileScript(projectsBuild(projects));
---

<section
  id="projects"
  aria-labelledby="projects-title"
  class="sp-section sp-projects"
  data-build={serializeTimeline(timeline)}
>
  <div class="sp-section-inner is-loose">
    <div class="sp-build-wrap" data-build-target="heading">
      <SectionHeading
        id="projects-title"
        eyebrow={strings.sections.projects.eyebrow}
        title={strings.sections.projects.title}
        lead={strings.sections.projects.lead}
      />
    </div>
    <div class="sp-projects-grid">
      {projects.map(({ id, data }, i) => (
        <div
          class="sp-projects-cell"
          data-build-target={`card-${id}`}
          data-build-blur={covers[i]?.blur}
        >
          <ProjectCard
            title={data.title}
            slug={id}
            year={data.year}
            summary={data.summary}
            tags={data.tags}
            status={data.status}
            repo={data.links.repo}
            cover={covers[i]?.cover}
          />
        </div>
      ))}
    </div>
  </div>
</section>
