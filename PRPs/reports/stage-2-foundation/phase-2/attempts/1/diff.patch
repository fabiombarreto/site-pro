+.sp-icon-btn {
+  box-sizing: border-box;
+  width: 36px;
+  height: 36px;
+  display: inline-grid;
+  place-items: center;
+  padding: 0;
+  border: 0;
+  border-radius: var(--radius-sm);
+  background: transparent;
+  color: var(--fg-muted);
+  cursor: pointer;
+  transition:
+    background-color 150ms,
+    color 150ms;
+}
+
+.sp-icon-btn:hover {
+  background: var(--bg-hover);
+  color: var(--fg);
+}
+
+/* A JS-only control: hidden (and out of the accessibility tree) until the deferred script sets data-js. */
+.sp-theme-toggle {
+  visibility: hidden;
+}
+
+html[data-js] .sp-theme-toggle {
+  visibility: visible;
+}
+
+.sp-theme-moon {
+  display: none;
+}
+
+html[data-theme='daylight'] .sp-theme-sun {
+  display: none;
+}
+
+html[data-theme='daylight'] .sp-theme-moon {
+  display: inline-block;
+}
