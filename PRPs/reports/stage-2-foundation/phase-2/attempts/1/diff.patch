+  font-size: var(--text-xl);
+  line-height: 1.3;
+  font-weight: 600;
+  letter-spacing: -0.01em;
+}
+
+.text-lg {
+  font-family: var(--font-sans);
+  font-size: var(--text-lg);
+  line-height: 1.6;
+  font-weight: 400;
+  letter-spacing: normal;
+}
+
+.text-md {
+  font-family: var(--font-sans);
+  font-size: var(--text-md);
+  line-height: 1.65;
+  font-weight: 400;
+  letter-spacing: normal;
+}
+
+.text-sm {
