+import {
+  THEME_STORAGE_KEY,
+  colorSchemeFor,
+  otherTheme,
+  parseTheme,
+  themeToggleLabel,
+} from './theme';
+
+const root = document.documentElement;
+const toggles = document.querySelectorAll<HTMLElement>('[data-theme-toggle]');
+
+function syncLabels(): void {
+  const label = themeToggleLabel(parseTheme(root.dataset.theme));
+  toggles.forEach((toggle) => {
+    toggle.setAttribute('aria-label', label);
+    toggle.setAttribute('title', label);
+  });
+}
+
+toggles.forEach((toggle) => {
+  toggle.addEventListener('click', () => {
+    const next = otherTheme(parseTheme(root.dataset.theme));
+    root.dataset.theme = next;
+    root.style.colorScheme = colorSchemeFor(next);
+    try {
+      localStorage.setItem(THEME_STORAGE_KEY, next);
+    } catch {
+      // Storage may be blocked; the in-page theme still changes.
+    }
+    syncLabels();
+  });
+});
+
+syncLabels();
+root.setAttribute('data-js', '');
diff --git a/src/scripts/theme.ts b/src/scripts/theme.ts
new file mode 100644
index 0000000..133b07c
--- /dev/null
+++ b/src/scripts/theme.ts
@@ -0,0 +1,23 @@
+export type Theme = 'midnight' | 'daylight';
+
+export const THEME_STORAGE_KEY = 'sp-theme';
+
+export const DEFAULT_THEME: Theme = 'midnight';
+
+export function parseTheme(value: unknown): Theme {
+  return value === 'daylight' ? 'daylight' : 'midnight';
+}
+
+export function otherTheme(theme: Theme): Theme {
+  return theme === 'midnight' ? 'daylight' : 'midnight';
+}
+
+export function themeToggleLabel(current: Theme): string {
+  return current === 'midnight'
+    ? 'Switch to the Daylight theme'
+    : 'Switch to the Midnight theme';
+}
+
+export function colorSchemeFor(theme: Theme): 'dark' | 'light' {
+  return theme === 'daylight' ? 'light' : 'dark';
+}
