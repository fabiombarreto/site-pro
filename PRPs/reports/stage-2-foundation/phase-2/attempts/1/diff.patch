+export type IconName = 'sun' | 'moon';
+
+interface IconProps {
+  name: IconName;
+  size?: number;
+  className?: string;
+}
+
+const LUCIDE: Record<IconName, React.JSX.Element[]> = {
+  sun: [
+    <circle key="0" cx="12" cy="12" r="4" />,
+    <path key="1" d="M12 2v2" />,
+    <path key="2" d="M12 20v2" />,
+    <path key="3" d="m4.93 4.93 1.41 1.41" />,
+    <path key="4" d="m17.66 17.66 1.41 1.41" />,
+    <path key="5" d="M2 12h2" />,
+    <path key="6" d="M20 12h2" />,
+    <path key="7" d="m6.34 17.66-1.41 1.41" />,
+    <path key="8" d="m19.07 4.93-1.41 1.41" />,
+  ],
+  moon: [
+    <path
+      key="0"
+      d="M20.985 12.486a9 9 0 1 1-9.473-9.472c.405-.022.617.46.402.803a6 6 0 0 0 8.268 8.268c.344-.215.825-.004.803.401"
+    />,
+  ],
+};
+
+export function Icon({
+  name,
+  size = 16,
+  className,
+}: IconProps): React.JSX.Element {
+  return (
+    <svg
+      className={className ? `sp-icon ${className}` : 'sp-icon'}
+      width={size}
+      height={size}
+      viewBox="0 0 24 24"
+      aria-hidden="true"
+      focusable="false"
+      fill="none"
+      stroke="currentColor"
+      strokeWidth="2"
+      strokeLinecap="round"
+      strokeLinejoin="round"
+    >
+      {LUCIDE[name]}
+    </svg>
+  );
+}
