diff --git a/src/content-schemas.ts b/src/content-schemas.ts
new file mode 100644
index 0000000..81dddb0
--- /dev/null
+++ b/src/content-schemas.ts
@@ -0,0 +1,89 @@
+import { z } from 'astro/zod';
+
+export const SUMMARY_MAX_LENGTH = 140;
+export const TAGS_MIN = 2;
+export const TAGS_MAX = 4;
+export const BIO_WORD_LIMIT = 100;
+
+export const PROJECT_STATUSES = [
+  'active',
+  'in development',
+  'planning',
+  'maintained',
+  'archived',
+] as const;
+
+const httpsUrl = z.url().refine((value) => value.startsWith('https://'), {
+  error: 'URL must start with https://',
+});
+
+const nonEmpty = z.string().min(1);
+
+export const profileSchema = z.strictObject({
+  name: nonEmpty,
+  headline: nonEmpty,
+  role: z.string(),
+  subtitle: z.string(),
+  photo: nonEmpty,
+  location: z.string().optional(),
+  bio: z
+    .string()
+    .refine(
+      (value) => value.split(/\s+/).filter(Boolean).length < BIO_WORD_LIMIT,
+      {
+        error: `Bio must have fewer than ${BIO_WORD_LIMIT} words`,
+      },
+    ),
+  links: z
+    .array(
+      z.strictObject({
+        label: z.string(),
+        url: httpsUrl,
+        icon: z.enum([
+          'github',
+          'linkedin',
+          'x',
+          'bluesky',
+          'devto',
+          'youtube',
+        ]),
+      }),
+    )
+    .min(1),
+  cv: z.string().optional(),
+});
+
+export const projectSchema = z.strictObject({
+  title: z.string(),
+  summary: z.string().max(SUMMARY_MAX_LENGTH),
+  cover: nonEmpty.optional(),
+  tags: z.array(nonEmpty).min(TAGS_MIN).max(TAGS_MAX),
+  links: z.strictObject({
+    repo: httpsUrl.optional(),
+    demo: httpsUrl.optional(),
+    article: httpsUrl.optional(),
+  }),
+  year: z.string().regex(/^\d{4}(?:[\u2013-]\d{4})?$/),
+  featured: z.boolean(),
+  order: z.number().int(),
+  status: z.enum(PROJECT_STATUSES),
+  githubRepo: z
+    .string()
+    .regex(/^[\w.-]+\/[\w.-]+$/)
+    .optional(),
+});
+
+export const stackSchema = z.strictObject({
+  groups: z
+    .array(
+      z.strictObject({
+        name: nonEmpty,
+        items: z.array(nonEmpty).min(1),
+      }),
+    )
+    .min(1),
+});
+
+export type Profile = z.infer<typeof profileSchema>;
+export type Project = z.infer<typeof projectSchema>;
+export type Stack = z.infer<typeof stackSchema>;
diff --git a/src/content.config.ts b/src/content.config.ts
new file mode 100644
