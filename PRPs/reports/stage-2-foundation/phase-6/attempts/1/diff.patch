@@ -0,0 +1,35 @@
+---
+import Base from '../layouts/Base.astro';
+import { Backdrop, DEFAULT_GLOWS } from '../components/page/Backdrop';
+import { Button } from '../components/page/Button';
+import { Footer } from '../components/page/Footer';
+import { NavBar } from '../components/page/NavBar';
+import { loadSiteChrome, pageTitle } from '../sections/site-chrome';
+import { strings } from '../strings';
+import '../styles/subpages.css';
+
+const { profile, links, sourceHref } = await loadSiteChrome();
+---
+
+<Base
+  title={pageTitle(strings.notFound.title, profile)}
+  description={profile.subtitle}
+>
+  <div class="sp-page">
+    <Backdrop glows={DEFAULT_GLOWS} />
+    <div class="sp-page-content">
+      <NavBar
+        githubHref={links.github}
+        linkedinHref={links.linkedin}
+        homeHref="/"
+      />
+      <main id="main" tabindex="-1" class="sp-subpage sp-notfound">
+        <h1 class="text-3xl sp-notfound-title">{strings.notFound.title}</h1>
+        <Button variant="primary" href="/">
+          {strings.notFound.homeLink}
+        </Button>
+      </main>
+      <Footer sourceHref={sourceHref} owner={profile.name} />
+    </div>
+  </div>
+</Base>
diff --git a/src/pages/projects/[slug].astro b/src/pages/projects/[slug].astro
new file mode 100644
index 0000000..7a00cf6
--- /dev/null
+++ b/src/pages/projects/[slug].astro
@@ -0,0 +1,61 @@
+---
+import { getCollection, render } from 'astro:content';
+import type { CollectionEntry } from 'astro:content';
+import Base from '../../layouts/Base.astro';
+import { Backdrop, DEFAULT_GLOWS } from '../../components/page/Backdrop';
+import { Footer } from '../../components/page/Footer';
+import { NavBar } from '../../components/page/NavBar';
+import { ProjectHeader } from '../../components/page/ProjectHeader';
+import { Prose } from '../../components/page/Prose';
+import { resolveAssetUrl } from '../../components/page/resolve-asset';
+import { loadSiteChrome, pageTitle } from '../../sections/site-chrome';
+import '../../styles/subpages.css';
+
+export async function getStaticPaths() {
+  return (await getCollection('projects')).map((entry) => ({
+    params: { slug: entry.id },
+    props: { entry },
+  }));
+}
+
+interface Props {
+  entry: CollectionEntry<'projects'>;
+}
+
+const { entry } = Astro.props;
+const { data } = entry;
+const { profile, links, sourceHref } = await loadSiteChrome();
+const hasBody = Boolean(entry.body?.trim());
+const Content = hasBody ? (await render(entry)).Content : undefined;
+---
+
+<Base title={pageTitle(data.title, profile)} description={data.summary}>
+  <div class="sp-page">
+    <Backdrop glows={DEFAULT_GLOWS} />
+    <div class="sp-page-content">
+      <NavBar
+        githubHref={links.github}
+        linkedinHref={links.linkedin}
+        homeHref="/"
+      />
+      <main id="main" tabindex="-1" class="sp-subpage">
+        <ProjectHeader
+          title={data.title}
+          slug={entry.id}
+          summary={data.summary}
+          year={data.year}
+          status={data.status}
+          tags={data.tags}
+          repo={data.links.repo}
+          cover={resolveAssetUrl(data.cover)}
+        />
+        {Content && (
+          <Prose>
+            <Content />
+          </Prose>
+        )}
+      </main>
+      <Footer sourceHref={sourceHref} owner={profile.name} />
+    </div>
+  </div>
+</Base>
diff --git a/src/sections/site-chrome.ts b/src/sections/site-chrome.ts
new file mode 100644
index 0000000..b536536
--- /dev/null
+++ b/src/sections/site-chrome.ts
@@ -0,0 +1,29 @@
+import { getCollection, getEntry } from 'astro:content';
+import type { CollectionEntry } from 'astro:content';
+import { profileLinks } from './profile-links';
+
+type ProfileData = CollectionEntry<'profile'>['data'];
+
+export async function loadSiteChrome(): Promise<{
+  profile: ProfileData;
+  links: { github: string; linkedin: string };
+  sourceHref: string;
+}> {
+  const profileEntry = await getEntry('profile', 'profile');
+  if (!profileEntry) throw new Error('The profile entry is missing');
+  const projects = await getCollection('projects');
+  const sourceHref = projects.find((p) => p.id === 'site-pro')?.data.links.repo;
+  if (!sourceHref) throw new Error('The site-pro project has no repo link');
+  return {
+    profile: profileEntry.data,
+    links: profileLinks(profileEntry.data),
+    sourceHref,
+  };
+}
+
+export function pageTitle(
+  label: string,
+  profile: { headline: string },
+): string {
+  return `${label.replace(/\.$/, '')} - ${profile.headline.replace(/\.$/, '')}`;
+}
