+++ b/src/components/page/MobileMenu.tsx
@@ -0,0 +1,61 @@
+import './NavBar.css';
+import { Button } from './Button';
+import { cx } from './cx';
+import { strings } from '../../strings';
+
+export const MOBILE_MENU_ID = 'mobile-menu';
+
+interface MobileMenuProps {
+  githubHref: string;
+  linkedinHref: string;
+  active?: string;
+  className?: string;
+}
+
+export function MobileMenu({
+  githubHref,
+  linkedinHref,
+  active,
+  className,
+}: MobileMenuProps): React.JSX.Element {
+  return (
+    <div
+      id={MOBILE_MENU_ID}
+      popover="auto"
+      className={cx('sp-menu', className)}
+    >
+      <nav aria-label={strings.nav.menuAriaLabel}>
+        <ul>
+          {strings.nav.links.map((link) => (
+            <li key={link.id}>
+              <a
+                className={cx(
+                  'sp-menu-link',
+                  active === link.id && 'is-active',
+                )}
+                href={`#${link.id}`}
+                aria-current={active === link.id ? 'true' : undefined}
+              >
+                <span className="sp-menu-num mono-xs">{link.index}</span>
+                <span className="text-xl">{link.label}</span>
+              </a>
+            </li>
+          ))}
+        </ul>
+      </nav>
+      <div className="sp-menu-foot">
+        <Button variant="secondary" href={githubHref} icon="github" external>
+          {strings.buttons.github}
+        </Button>
+        <Button
+          variant="secondary"
+          href={linkedinHref}
+          icon="linkedin"
+          external
+        >
+          {strings.buttons.linkedin}
+        </Button>
+      </div>
+    </div>
+  );
+}
diff --git a/src/components/page/NavBar.css b/src/components/page/NavBar.css
new file mode 100644
index 0000000..03c9488
--- /dev/null
+++ b/src/components/page/NavBar.css
@@ -0,0 +1,136 @@
+.sp-nav {
+  position: relative;
+  height: var(--nav-height);
+  border-bottom: 1px solid transparent;
+  transition:
+    background-color 200ms,
+    border-color 200ms;
+}
+
+.sp-nav-inner {
+  box-sizing: border-box;
+  height: 100%;
+  max-width: var(--container);
+  margin: 0 auto;
+  padding: 0 var(--space-8);
+  display: grid;
+  grid-template-columns: 1fr auto 1fr;
+  align-items: center;
+  gap: var(--space-6);
+}
+
+.sp-nav-name {
+  justify-self: start;
+  color: var(--fg);
+  font-size: 16px;
+  font-weight: 600;
+  letter-spacing: -0.01em;
+  text-decoration: none;
+  border-radius: 2px;
+}
+
+.sp-nav-links {
+  display: flex;
+  gap: var(--space-1);
+}
+
+.sp-nav-link {
+  position: relative;
+  padding: var(--space-2) var(--space-3);
+  border-radius: var(--radius-sm);
+  color: var(--fg-muted);
+  text-decoration: none;
+  transition: color 150ms;
+}
+
+.sp-nav-link:hover,
+.sp-nav-link.is-active {
+  color: var(--fg);
+}
+
+.sp-nav-link.is-active::after {
+  content: '';
+  position: absolute;
+  left: var(--space-3);
+  right: var(--space-3);
+  bottom: 2px;
+  height: 2px;
+  border-radius: 2px;
+  background: var(--accent);
+}
+
+.sp-nav-actions {
+  justify-self: end;
+  display: flex;
+  align-items: center;
+  gap: var(--space-1);
+}
+
+/* The menu is a native popover: the browser's own top layer, light dismiss and Esc. */
+.sp-menu {
+  position: fixed;
+  inset: var(--nav-height) 0 auto 0;
+  box-sizing: border-box;
+  width: auto;
+  max-width: none;
+  margin: 0;
+  padding: var(--space-2) var(--space-4) var(--space-6);
+  border: 0;
+  border-bottom: 1px solid var(--border);
+  background: var(--bg-raised);
+  color: var(--fg);
+}
+
+.sp-menu ul {
+  margin: 0;
+  padding: 0;
+  list-style: none;
+}
+
+.sp-menu-link {
+  display: flex;
+  align-items: baseline;
+  gap: var(--space-3);
+  padding: var(--space-4) var(--space-1);
+  border-bottom: 1px solid var(--border);
+  color: var(--fg);
+  text-decoration: none;
+  border-radius: 2px;
+}
+
+.sp-menu-num {
+  color: var(--fg-muted);
+}
+
+.sp-menu-link.is-active .sp-menu-num {
+  color: var(--accent-fg);
+}
+
+.sp-menu-foot {
+  display: flex;
+  gap: var(--space-3);
+  margin-top: var(--space-6);
+}
+
+.sp-menu-foot .sp-btn {
+  flex: 1;
+}
+
+@media (max-width: 767px) {
+  .sp-nav-inner {
+    grid-template-columns: 1fr auto;
+    padding-left: var(--space-4);
+    padding-right: var(--space-4);
+  }
+
+  .sp-nav-links {
+    display: none;
+  }
+}
+
+@media (min-width: 768px) {
+  .sp-menu-toggle,
+  .sp-menu {
+    display: none;
+  }
