index 0000000..d461007
--- /dev/null
+++ b/src/components/build/AsciiOverlay.ts
@@ -0,0 +1,47 @@
+import { h } from './dom';
+
+interface Rect {
+  x: number;
+  y: number;
+  width: number;
+  height: number;
+}
+
+interface Geometry {
+  fontSize: number;
+  lineHeight: number;
+}
+
+export interface AsciiOverlay {
+  el: HTMLPreElement;
+  setPlacement(rect: Rect, geometry: Geometry): void;
+  setText(text: string): void;
+  setOpacity(value: number): void;
+}
+
+export function createAsciiOverlay(): AsciiOverlay {
+  const el = h('pre', 'sp-ascii', { 'aria-hidden': 'true' });
+  let lastText: string | null = null;
+  let lastOpacity = -1;
+
+  return {
+    el,
+    setPlacement(rect, geometry) {
+      el.style.transform = `translate3d(${rect.x}px, ${rect.y}px, 0)`;
+      el.style.width = `${rect.width}px`;
+      el.style.height = `${rect.height}px`;
+      el.style.fontSize = `${geometry.fontSize}px`;
+      el.style.lineHeight = `${geometry.lineHeight}px`;
+    },
+    setText(text) {
+      if (text === lastText) return;
+      lastText = text;
+      el.textContent = text;
+    },
+    setOpacity(value) {
+      if (value === lastOpacity) return;
+      lastOpacity = value;
+      el.style.opacity = String(value);
+    },
+  };
+}
diff --git a/src/components/build/BlurCover.ts b/src/components/build/BlurCover.ts
new file mode 100644
index 0000000..0e09ec8
--- /dev/null
+++ b/src/components/build/BlurCover.ts
@@ -0,0 +1,40 @@
+import { h } from './dom';
+
+interface Rect {
+  x: number;
+  y: number;
+  width: number;
+  height: number;
+}
+
+export interface BlurCover {
+  el: HTMLDivElement;
+  setPlacement(rect: Rect): void;
+  setOpacity(value: number): void;
+}
+
+export function createBlurCover(src: string): BlurCover {
+  const el = h('div', 'sp-blur-cover', { 'aria-hidden': 'true' });
+  const img = h('img', undefined, {
+    alt: '',
+    'aria-hidden': 'true',
+    decoding: 'async',
+  });
+  img.src = src;
+  el.append(img);
+  let lastOpacity = -1;
+
+  return {
+    el,
+    setPlacement(rect) {
+      el.style.transform = `translate3d(${rect.x}px, ${rect.y}px, 0)`;
+      el.style.width = `${rect.width}px`;
+      el.style.height = `${rect.height}px`;
+    },
+    setOpacity(value) {
+      if (value === lastOpacity) return;
+      lastOpacity = value;
+      el.style.opacity = String(value);
+    },
+  };
+}
