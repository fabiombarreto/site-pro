+++ b/src/components/build/BuildWindow.ts
@@ -0,0 +1,77 @@
+import { easeOut } from '../../runtime/layer-timing';
+import { createCommandLine } from './CommandLine';
+import { h } from './dom';
+
+export type WindowState = 'opening' | 'building' | 'closing';
+
+export interface BuildWindow {
+  el: HTMLDivElement;
+  setPlacement(rect: {
+    x: number;
+    y: number;
+    width: number;
+    height: number;
+  }): void;
+  setCommand(call: string, chars: number, cursor: boolean): void;
+  setOpen(progress: number, origin: { x: number; y: number }): void;
+  setClosing(progress: number): void;
+  setState(state: WindowState): void;
+}
+
+export function createBuildWindow(file: string, section: string): BuildWindow {
+  const el = h('div', 'sp-window', {
+    'aria-hidden': 'true',
+    'data-section': section,
+    'data-file': file,
+    'data-state': 'opening',
+  });
+  const frame = h('div', 'sp-window-frame');
+  const body = h('div', 'sp-window-body');
+  const chrome = h('div', 'sp-window-chrome');
+  const bar = h('div', 'sp-window-bar');
+  const dots = h('div', 'sp-dots');
+  for (let i = 0; i < 3; i++) dots.append(h('span', 'sp-dot'));
+  const name = h('span', 'sp-window-file');
+  name.textContent = file;
+  bar.append(dots, name);
+  const cmd = h('div', 'sp-window-cmd');
+  const line = createCommandLine();
+  cmd.append(line.el);
+  chrome.append(bar, cmd);
+  frame.append(body, chrome);
+  el.append(frame);
+
+  let state: WindowState = 'opening';
+  let lastOpen = -1;
+  let lastClosing = -1;
+
+  return {
+    el,
+    setPlacement(rect) {
+      // top/left, not a transform: sticky offsets ignore an ancestor's transform.
+      el.style.left = `${rect.x}px`;
+      el.style.top = `${rect.y}px`;
+      el.style.width = `${rect.width}px`;
+      el.style.height = `${rect.height}px`;
+    },
+    setCommand: line.set,
+    setOpen(progress, origin) {
+      if (progress === lastOpen) return;
+      lastOpen = progress;
+      const eased = easeOut(progress);
+      frame.style.transformOrigin = `${origin.x}px ${origin.y}px`;
+      frame.style.transform = `scale(${0.96 + 0.04 * eased})`;
+      frame.style.opacity = String(eased);
+    },
+    setClosing(progress) {
+      if (progress === lastClosing) return;
+      lastClosing = progress;
+      frame.style.opacity = String(1 - progress);
+    },
+    setState(next) {
+      if (next === state) return;
+      state = next;
+      el.setAttribute('data-state', next);
+    },
+  };
+}
diff --git a/src/components/build/CommandDock.ts b/src/components/build/CommandDock.ts
new file mode 100644
index 0000000..c3d3466
--- /dev/null
+++ b/src/components/build/CommandDock.ts
@@ -0,0 +1,132 @@
+import { buildStrings } from '../../strings';
+import { createCommandLine } from './CommandLine';
+import { createCursor } from './Cursor';
+import { createLogLine } from './LogLine';
+import { h } from './dom';
+
+export type DockState =
+  | 'hidden'
+  | 'typing'
+  | 'building'
+  | 'created'
+  | 'idle'
+  | 'done'
+  | 'reduced'
+  | 'collapsed';
+
+export interface CommandDock {
+  el: HTMLDivElement;
+  setState(state: DockState): void;
+  setCommand(command: string, chars: number, cursor: boolean): void;
+  setLog(text: string | null): void;
+  setBuilding(name: string, spinnerFrame: number): void;
+  setCreated(text: string): void;
+  setIdle(done: number, total: number): void;
+  setDone(text: string): void;
+  setOpacity(value: number): void;
+  getRect(): DOMRect;
+}
+
+export function createCommandDock(): CommandDock {
+  const el = h('div', 'sp-dock', {
+    'aria-hidden': 'true',
+    'data-state': 'hidden',
+  });
+  const log = h('div', 'sp-dock-log');
+  const pill = h('div', 'sp-dock-pill');
+  const status = h('div', 'sp-dock-status');
+  const hint = h('span', 'sp-dock-hint');
+  pill.append(status, hint);
+  el.append(log, pill);
+
+  const logLine = createLogLine('info', '');
+  const command = createCommandLine();
+  const spinner = createLogLine('info', '', true);
+  const text = h('span', 'sp-dock-text');
+  const idle = h('span', 'sp-dock-text');
+  const prompt = (): HTMLSpanElement => {
+    const span = h('span', 'sp-prompt');
+    span.textContent = buildStrings.prompt;
+    return span;
+  };
+
+  let state: DockState = 'hidden';
+  let mode = '';
+  let lastLog: string | null = null;
+  let lastOpacity = '';
+  let idleKey = '';
+
+  const show = (next: string, nodes: Node[], hintText = '') => {
+    if (mode !== next) {
+      mode = next;
+      status.replaceChildren(...nodes);
+    }
+    if (hint.textContent !== hintText) hint.textContent = hintText;
+  };
+
+  return {
+    el,
+    setState(next) {
+      if (next === state) return;
+      state = next;
+      el.setAttribute('data-state', next);
+      if (next === 'reduced') {
+        text.textContent = buildStrings.reducedReady;
+        mode = 'reduced';
+        status.replaceChildren(text, createCursor());
+        hint.textContent = '';
+      } else if (next === 'collapsed') {
+        const fab = h('span', 'sp-dock-fab');
+        fab.textContent = buildStrings.collapsedGlyph;
+        mode = 'collapsed';
+        status.replaceChildren(fab);
+        hint.textContent = '';
+      }
+    },
+    setCommand(value, chars, cursor) {
+      show('command', [prompt(), command.el]);
+      command.set(value, chars, cursor);
+    },
+    setLog(value) {
+      if (value === lastLog) return;
+      lastLog = value;
+      if (value === null) {
+        log.replaceChildren();
+      } else {
+        logLine.setText(value);
+        log.replaceChildren(logLine.el);
+      }
+    },
+    setBuilding(name, frame) {
+      show('building', [spinner.el]);
+      spinner.setText(buildStrings.building(name));
+      spinner.setSpinnerFrame(frame);
+    },
+    setCreated(value) {
+      show('text', [text]);
+      if (text.textContent !== value) text.textContent = value;
+    },
+    setIdle(done, total) {
+      const key = `${done}/${total}`;
+      if (mode !== 'idle' || key !== idleKey) {
+        idleKey = key;
+        idle.textContent = buildStrings.idleCount(done, total);
+        mode = '';
+        show('idle', [idle, prompt(), createCursor()], buildStrings.scrollHint);
+      }
+    },
+    setDone(value) {
+      show('text', [text]);
+      if (text.textContent !== value) text.textContent = value;
+    },
+    setOpacity(value) {
+      const next = String(value);
+      if (next === lastOpacity) return;
+      lastOpacity = next;
+      el.style.opacity = next;
+    },
+    getRect() {
+      return el.getBoundingClientRect();
+    },
+  };
+}
diff --git a/src/components/build/CommandLine.ts b/src/components/build/CommandLine.ts
