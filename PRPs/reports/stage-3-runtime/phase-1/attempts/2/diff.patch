+  return {
+    section: 'contact',
+    file: 'contact.tsx',
+    command: 'renderContact();',
+    steps: [
+      {
+        call: `contact.heading("${strings.sections.contact.title}")`,
+        target: 'heading',
+        effect: 'type-text',
+        text: strings.sections.contact.title,
+      },
+      { call: 'contact.links([…])', target: 'links', effect: 'pop' },
+      {
+        call: 'contact.location(…)',
+        target: 'location',
+        effect: 'type-text',
+        text: profile.location,
+      },
+    ],
+  };
+}
