+import type { CollectionEntry } from 'astro:content';
+import type { BuildScript, BuildStep } from '../runtime/types';
+import { strings } from '../strings';
+
+export function projectsBuild(
+  projects: CollectionEntry<'projects'>[],
+): BuildScript {
+  const cards: BuildStep[] = projects.map(({ id }, index) => ({
+    call: `projects.card("${id}")`,
+    target: `card-${id}`,
+    effect: 'build-card',
+    ...(index > 0 ? { overlap: 120 } : {}),
+  }));
+  return {
+    section: 'projects',
+    file: 'projects.tsx',
+    command: 'renderProjects();',
+    steps: [
+      {
+        call: `projects.heading("${strings.sections.projects.title}")`,
+        target: 'heading',
+        effect: 'type-text',
+        text: strings.sections.projects.title,
+      },
+      ...cards,
+    ],
+  };
+}
