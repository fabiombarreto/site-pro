+import type { CollectionEntry } from 'astro:content';
+import type { BuildScript, BuildStep } from '../runtime/types';
+import { strings } from '../strings';
+
+type StackData = CollectionEntry<'stack'>['data'];
+
+export function stackBuild(stack: StackData): BuildScript {
+  const groups: BuildStep[] = stack.groups.map((group, index) => ({
+    call: `stack.group("${group.name}")`,
+    target: `group-${index}`,
+    effect: 'stagger',
+    count: group.items.length,
+  }));
+  return {
+    section: 'stack',
+    file: 'stack.tsx',
+    command: 'renderStack();',
+    steps: [
+      {
+        call: `stack.heading("${strings.sections.stack.title}")`,
+        target: 'heading',
+        effect: 'type-text',
+        text: strings.sections.stack.title,
+      },
+      ...groups,
+    ],
+  };
+}
