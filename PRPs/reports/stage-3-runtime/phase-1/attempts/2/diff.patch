diff --git a/src/runtime/clock.ts b/src/runtime/clock.ts
new file mode 100644
index 0000000..670aad4
--- /dev/null
+++ b/src/runtime/clock.ts
@@ -0,0 +1,49 @@
+export interface Clock {
+  now(): number;
+  onFrame(cb: (now: number) => void): () => void;
+}
+
+export const realClock: Clock = {
+  now: () => performance.now(),
+  onFrame(cb) {
+    let handle = 0;
+    let active = true;
+    const tick = (now: number) => {
+      if (!active) return;
+      handle = requestAnimationFrame(tick);
+      cb(now);
+    };
+    handle = requestAnimationFrame(tick);
+    return () => {
+      active = false;
+      cancelAnimationFrame(handle);
+    };
+  },
+};
+
+export interface ManualClock extends Clock {
+  advance(ms: number, step?: number): void;
+}
+
+export function createManualClock(start = 0): ManualClock {
+  let current = start;
+  const listeners = new Set<(now: number) => void>();
+  return {
+    now: () => current,
+    onFrame(cb) {
+      listeners.add(cb);
+      return () => {
+        listeners.delete(cb);
+      };
+    },
+    advance(ms, step = 16) {
+      let remaining = ms;
+      while (remaining > 0) {
+        const chunk = Math.min(step, remaining);
+        current += chunk;
+        remaining -= chunk;
+        for (const cb of [...listeners]) cb(current);
+      }
+    },
+  };
+}
diff --git a/src/runtime/compiler.ts b/src/runtime/compiler.ts
new file mode 100644
index 0000000..f84cc27
--- /dev/null
+++ b/src/runtime/compiler.ts
@@ -0,0 +1,110 @@
+import {
+  EFFECTS,
+  type BuildScript,
+  type BuildStep,
+  type EffectName,
+  type Timeline,
+  type TimelineStep,
+} from './types';
+
+// Provisional effect durations in ms at 1x. Phase 3 tunes this table.
+export const EFFECT_DURATION_MS: Record<
+  EffectName,
+  (step: BuildStep) => number | string
+> = {
+  select: () => 150,
+  skeleton: () => 300,
+  'type-text': (s) =>
+    s.text === undefined ? 'needs text' : 150 + s.text.length * 28,
+  decode: (s) =>
+    s.text === undefined ? 'needs text' : 150 + s.text.length * 20,
+  'resolve-lines': (s) =>
+    s.count === undefined ? 'needs count' : 150 + s.count * 60,
+  pop: () => 300,
+  stagger: (s) => (s.count === undefined ? 'needs count' : 150 + s.count * 80),
+  'build-card': () => 600,
+};
+
+const COMMAND_START_MS = 250;
+const COMMAND_CHAR_MS = 40;
+const COMMAND_SETTLE_MS = 80;
+const WINDOW_OPEN_MS = 100;
+const WINDOW_HOLD_MS = 280;
+const DEFAULT_SETTLE_MS = 300;
+const CLOSING_MS = 500;
+
+function fail(script: BuildScript, i: number, call: string, problem: string) {
+  return new Error(
+    `build script "${script.section}" step ${i} (${call}): ${problem}`,
+  );
+}
+
+function durationOf(script: BuildScript, step: BuildStep, i: number): number {
+  if (!(EFFECTS as readonly string[]).includes(step.effect)) {
+    throw fail(script, i, step.call, `unknown effect "${step.effect}"`);
+  }
+  if (step.target.trim() === '') {
+    throw fail(script, i, step.call, 'empty target');
+  }
+  if (/[<>]/.test(step.call)) {
+    throw fail(script, i, step.call, 'call must not contain < or >');
+  }
+  const result = EFFECT_DURATION_MS[step.effect](step);
+  if (typeof result === 'string') throw fail(script, i, step.call, result);
+  return result;
+}
+
+export function compileScript(script: BuildScript): Timeline {
+  if (script.steps.length === 0) {
+    throw new Error(`build script "${script.section}": no steps`);
+  }
+  if (/[<>]/.test(script.command)) {
+    throw new Error(
+      `build script "${script.section}": command must not contain < or >`,
+    );
+  }
+  const commandEnd =
+    script.timing?.commandEnd ??
+    COMMAND_START_MS +
+      script.command.length * COMMAND_CHAR_MS +
+      COMMAND_SETTLE_MS;
+  const windowEnd = script.timing?.windowEnd ?? commandEnd + WINDOW_OPEN_MS;
+  const buildStart = script.timing?.buildStart ?? windowEnd + WINDOW_HOLD_MS;
+
+  const steps: TimelineStep[] = [];
+  let previousEnd = buildStart;
+  script.steps.forEach((step, i) => {
+    const length = durationOf(script, step, i);
+    const start =
+      i === 0
+        ? buildStart + (step.gap ?? 0)
+        : previousEnd + (step.gap ?? 0) - (step.overlap ?? 0);
+    const end = start + length;
+    steps.push({
+      call: step.call,
+      target: step.target,
+      effect: step.effect,
+      start,
+      end,
+    });
+    previousEnd = end;
+  });
+
+  const createdAt = previousEnd + (script.settle ?? DEFAULT_SETTLE_MS);
+  return {
+    v: 1,
+    section: script.section,
+    file: script.file,
+    command: script.command,
+    commandEnd,
+    windowEnd,
+    buildStart,
+    steps,
+    createdAt,
+    duration: createdAt + CLOSING_MS,
+  };
+}
+
+export function serializeTimeline(timeline: Timeline): string {
+  return JSON.stringify(timeline);
+}
