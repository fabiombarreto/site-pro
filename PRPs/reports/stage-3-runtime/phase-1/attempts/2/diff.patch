@@ -0,0 +1,41 @@
+import type { CollectionEntry } from 'astro:content';
+import type { BuildScript } from '../runtime/types';
+
+type ProfileData = CollectionEntry<'profile'>['data'];
+
+export function heroBuild(profile: ProfileData): BuildScript {
+  const words = profile.subtitle.split(/\s+/).filter(Boolean).length;
+  return {
+    section: 'top',
+    file: 'hero.tsx',
+    command: 'startSite();',
+    timing: { commandEnd: 730, windowEnd: 1000, buildStart: 1300 },
+    steps: [
+      {
+        call: `hero.title("${profile.headline}")`,
+        target: 'title',
+        effect: 'type-text',
+        text: profile.headline,
+      },
+      {
+        call: `hero.role("${profile.role}")`,
+        target: 'role',
+        effect: 'type-text',
+        text: profile.role,
+      },
+      { call: 'hero.photo(…)', target: 'photo', effect: 'skeleton' },
+      {
+        call: 'hero.intro(…)',
+        target: 'intro',
+        effect: 'resolve-lines',
+        count: words,
+      },
+      {
+        call: 'hero.links([…])',
+        target: 'links',
+        effect: 'pop',
+        gap: 60,
+      },
+    ],
+  };
+}
