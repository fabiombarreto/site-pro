+++ b/src/runtime/main.ts
@@ -0,0 +1,102 @@
+import { parseSpeed } from '../scripts/build-mode';
+import { currentSection, progress, speed, status } from '../stores/build';
+import { realClock } from './clock';
+import { createScheduler } from './scheduler';
+import { observeSections } from './triggers';
+import type { SectionId, Timeline } from './types';
+
+const IDS: SectionId[] = ['top', 'about', 'projects', 'stack', 'contact'];
+
+const root = document.documentElement;
+let cancelFrame: (() => void) | null = null;
+let stopObserver: (() => void) | null = null;
+const sections: HTMLElement[] = [];
+
+function reveal(): void {
+  cancelFrame?.();
+  stopObserver?.();
+  for (const s of sections) s.setAttribute('data-build-state', 'done');
+  root.removeAttribute('data-build-mode');
+  status.set('failed');
+}
+
+function guard<A extends unknown[]>(fn: (...args: A) => void) {
+  return (...args: A): void => {
+    try {
+      fn(...args);
+    } catch (error) {
+      reveal();
+      console.error(error);
+    }
+  };
+}
+
+function start(): void {
+  for (const id of IDS) {
+    const el = document.getElementById(id);
+    if (!el) throw new Error(`section #${id} is missing`);
+    sections.push(el);
+  }
+  const timelines = sections.map(
+    (s) => JSON.parse(s.dataset.build ?? '') as Timeline,
+  );
+  const startSpeed = parseSpeed(root.dataset.buildSpeed);
+  speed.set(startSpeed);
+  for (const s of sections) s.setAttribute('data-build-state', 'pending');
+
+  currentSection.subscribe((v) => {
+    if (v === null) root.removeAttribute('data-build-section');
+    else root.setAttribute('data-build-section', v);
+  });
+  progress.subscribe((v) =>
+    root.setAttribute('data-build-progress', String(v)),
+  );
+  status.subscribe((v) => root.setAttribute('data-build-status', v));
+  speed.subscribe((v) => root.setAttribute('data-build-speed', v));
+
+  if (root.dataset.buildMode === 'instant') {
+    for (const s of sections) s.setAttribute('data-build-state', 'done');
+    status.set('instant');
+    status.set('done');
+    // data-build-mode stays "instant": the pending CSS never matches it, and
+    // AC-A5 has <html> carry the resolved mode.
+    root.setAttribute('data-build-started', '');
+    return;
+  }
+
+  const byId = new Map(sections.map((s) => [s.id, s]));
+  const scheduler = createScheduler({
+    clock: {
+      now: realClock.now,
+      onFrame(cb) {
+        const cancel = realClock.onFrame(guard(cb));
+        cancelFrame = cancel;
+        return cancel;
+      },
+    },
+    timelines,
+    speed: startSpeed,
+    host: {
+      onState: guard((id, state) => {
+        byId.get(id)?.setAttribute('data-build-state', state);
+        if (state !== 'pending' && status.get() !== 'building') {
+          status.set('building');
+        }
+      }),
+      onProgress: guard((section, fraction) => {
+        currentSection.set(section);
+        progress.set(fraction);
+      }),
+      onIdle: guard(() => status.set('idle')),
+      onAllDone: guard(() => {
+        status.set('done');
+        root.removeAttribute('data-build-mode');
+      }),
+      isHidden: () => document.visibilityState === 'hidden',
+    },
+  });
+  stopObserver = observeSections(sections, guard(scheduler.trigger));
+  root.setAttribute('data-build-started', '');
+}
+
+guard(start)();
diff --git a/src/runtime/scheduler.ts b/src/runtime/scheduler.ts
new file mode 100644
index 0000000..c078f02
--- /dev/null
+++ b/src/runtime/scheduler.ts
@@ -0,0 +1,193 @@
+import type { Speed } from '../scripts/build-mode';
+import type { Clock } from './clock';
+import type { SectionId, SectionState, Timeline } from './types';
+
+export const TURBO_FACTOR = 5;
+export const MAX_FRAME_MS = 50;
+
+export interface SchedulerHost {
+  onState(id: SectionId, state: SectionState): void;
+  onProgress(section: SectionId | null, fraction: number): void;
+  onIdle(): void;
+  onAllDone(): void;
+  isHidden(): boolean;
+}
+
+export interface SchedulerOptions {
+  clock: Clock;
+  timelines: Timeline[];
+  speed: Speed;
+  host: SchedulerHost;
+}
+
+export interface Scheduler {
+  trigger(id: SectionId): void;
+  finish(id: SectionId): void;
+  setSpeed(speed: Speed): void;
+  destroy(): void;
+}
+
+interface Entry {
+  timeline: Timeline;
+  state: SectionState;
+  t: number;
+}
+
+function stateAt(timeline: Timeline, t: number): SectionState {
+  if (t >= timeline.duration) return 'done';
+  if (t >= timeline.createdAt) return 'closing';
+  if (t >= timeline.buildStart) return 'building';
+  // The short hold between the window opening (windowEnd) and the build start
+  // is also reported as "window".
+  if (t >= timeline.commandEnd) return 'window';
+  return 'command';
+}
+
+export function createScheduler(options: SchedulerOptions): Scheduler {
+  const { clock, host } = options;
+  const entries: Entry[] = options.timelines.map((timeline) => ({
+    timeline,
+    state: 'pending',
+    t: 0,
+  }));
+  let speed: Speed = options.speed;
+  let active = -1;
+  let unsubscribe: (() => void) | null = null;
+  let lastNow = 0;
+  let lastPublished = '';
+  let allDoneFired = false;
+
+  const indexOf = (id: SectionId) =>
+    entries.findIndex((e) => e.timeline.section === id);
+
+  const setState = (entry: Entry, state: SectionState) => {
+    if (entry.state === state) return;
+    entry.state = state;
+    host.onState(entry.timeline.section, state);
+  };
+
+  const publish = (section: SectionId | null, fraction: number) => {
+    const rounded = Math.round(fraction * 100) / 100;
+    const key = `${section ?? ''}:${rounded}`;
+    if (key === lastPublished) return;
+    lastPublished = key;
+    host.onProgress(section, rounded);
+  };
+
+  const isFinished = (e: Entry) => e.state === 'done' || e.state === 'skipped';
+
+  const stop = () => {
+    unsubscribe?.();
+    unsubscribe = null;
+  };
+
+  const checkAllDone = () => {
+    if (!allDoneFired && entries.every(isFinished)) {
+      allDoneFired = true;
+      host.onAllDone();
+    }
+  };
+
+  const startNext = () => {
+    const next = entries.findIndex((e) => e.state === 'queued');
+    if (next === -1) {
+      active = -1;
+      stop();
+      publish(null, 0);
+      host.onIdle();
+      checkAllDone();
+      return;
+    }
+    active = next;
+    const entry = entries[next];
+    entry.t = 0;
+    setState(entry, stateAt(entry.timeline, 0));
+    publish(entry.timeline.section, 0);
+    if (!unsubscribe) {
+      lastNow = clock.now();
+      unsubscribe = clock.onFrame(onFrame);
+    }
+  };
+
+  const complete = (entry: Entry) => {
+    setState(entry, 'done');
+    if (entries[active] === entry) startNext();
+    else checkAllDone();
+  };
+
+  function onFrame(now: number): void {
+    if (host.isHidden()) {
+      // Time spent hidden is never accumulated: re-measure from the next
+      // visible frame.
+      lastNow = now;
+      return;
+    }
+    const dt = Math.min(Math.max(now - lastNow, 0), MAX_FRAME_MS);
+    lastNow = now;
+    if (active === -1) return;
+    const entry = entries[active];
+    const turbo = entries[active + 1]?.state === 'queued';
+    const factor = (speed === '2' ? 2 : 1) * (turbo ? TURBO_FACTOR : 1);
+    entry.t += dt * factor;
+    if (entry.t >= entry.timeline.duration) {
+      publish(entry.timeline.section, 1);
+      complete(entry);
+      return;
+    }
+    setState(entry, stateAt(entry.timeline, entry.t));
+    publish(entry.timeline.section, entry.t / entry.timeline.duration);
+  }
+
+  const finishUpTo = (index: number) => {
+    for (let i = 0; i <= index; i++) {
+      const entry = entries[i];
+      if (!isFinished(entry)) {
+        const wasActive = i === active;
+        setState(entry, 'done');
+        if (wasActive) active = -1;
+      }
+    }
+    if (active === -1) startNext();
+    else checkAllDone();
+  };
+
+  return {
+    trigger(id) {
+      const index = indexOf(id);
+      if (index === -1) return;
+      if (speed === 'inf') {
+        finishUpTo(index);
+        return;
+      }
+      for (let i = 0; i <= index; i++) {
+        if (entries[i].state === 'pending') setState(entries[i], 'queued');
+      }
+      if (active === -1) startNext();
+    },
+    finish(id) {
+      const index = indexOf(id);
+      if (index === -1 || isFinished(entries[index])) return;
+      const wasActive = index === active;
+      setState(entries[index], 'done');
+      if (wasActive) {
+        active = -1;
+        startNext();
+      } else {
+        checkAllDone();
+      }
+    },
+    setSpeed(next) {
+      speed = next;
+      if (next !== 'inf') return;
+      let last = active;
+      entries.forEach((e, i) => {
+        if (e.state === 'queued') last = Math.max(last, i);
+      });
+      if (last >= 0) finishUpTo(last);
+    },
+    destroy() {
+      stop();
+      active = -1;
+    },
+  };
+}
diff --git a/src/runtime/triggers.ts b/src/runtime/triggers.ts
new file mode 100644
index 0000000..9768416
--- /dev/null
+++ b/src/runtime/triggers.ts
@@ -0,0 +1,23 @@
+import type { SectionId } from './types';
+
+export function observeSections(
+  sections: HTMLElement[],
+  onTrigger: (id: SectionId) => void,
+): () => void {
+  const fired = new Set<Element>();
+  const observer = new IntersectionObserver(
+    (entries) => {
+      for (const entry of entries) {
+        if (fired.has(entry.target)) continue;
+        if (entry.isIntersecting || entry.boundingClientRect.top < 0) {
+          fired.add(entry.target);
+          observer.unobserve(entry.target);
+          onTrigger(entry.target.id as SectionId);
+        }
+      }
+    },
+    { rootMargin: '0px 0px -25% 0px', threshold: 0 },
+  );
+  for (const section of sections) observer.observe(section);
+  return () => observer.disconnect();
+}
