diff --git a/src/runtime/effect-dom.ts b/src/runtime/effect-dom.ts
new file mode 100644
index 0000000..34c239e
--- /dev/null
+++ b/src/runtime/effect-dom.ts
@@ -0,0 +1,198 @@
+// DOM helpers for the element effects. Read-only measurement plus the few
+// writes effects may make on a page element: the data-build-fx attribute and
+// the inline opacity and clip-path. Nothing here writes transform, display,
+// visibility or text to a page element.
+
+export interface Box {
+  x: number;
+  y: number;
+  width: number;
+  height: number;
+}
+
+export interface MeasuredChar {
+  ch: string;
+  x: number;
+  right: number;
+}
+
+export interface MeasuredLine {
+  // Clip bounds: extended halfway to the neighbour lines, element-relative.
+  top: number;
+  bottom: number;
+  left: number;
+  right: number;
+  // The glyph rects of the line itself, element-relative.
+  textTop: number;
+  textBottom: number;
+  chars: MeasuredChar[];
+}
+
+const round = (value: number) => Math.round(value * 10) / 10;
+
+export function docRect(el: HTMLElement): Box {
+  const r = el.getBoundingClientRect();
+  return {
+    x: r.left + window.scrollX,
+    y: r.top + window.scrollY,
+    width: r.width,
+    height: r.height,
+  };
+}
+
+export function measureLines(el: HTMLElement): MeasuredLine[] {
+  const box = el.getBoundingClientRect();
+  const walker = document.createTreeWalker(el, NodeFilter.SHOW_TEXT);
+  const range = document.createRange();
+  const lines: MeasuredLine[] = [];
+  for (let node = walker.nextNode(); node; node = walker.nextNode()) {
+    const text = (node as Text).data;
+    for (let i = 0; i < text.length; i++) {
+      range.setStart(node, i);
+      range.setEnd(node, i + 1);
+      const rect = range.getClientRects()[0];
+      if (!rect) continue;
+      if (rect.width === 0 && /\s/.test(text[i])) continue;
+      const top = rect.top - box.top;
+      const bottom = rect.bottom - box.top;
+      const middle = (top + bottom) / 2;
+      const char = {
+        ch: text[i],
+        x: rect.left - box.left,
+        right: rect.right - box.left,
+      };
+      let line = lines[lines.length - 1];
+      if (!line || middle < line.textTop || middle > line.textBottom) {
+        line = {
+          top: 0,
+          bottom: 0,
+          left: char.x,
+          right: char.right,
+          textTop: top,
+          textBottom: bottom,
+          chars: [],
+        };
+        lines.push(line);
+      }
+      line.textTop = Math.min(line.textTop, top);
+      line.textBottom = Math.max(line.textBottom, bottom);
+      line.left = Math.min(line.left, char.x);
+      line.right = Math.max(line.right, char.right);
+      line.chars.push(char);
+    }
+  }
+  lines.forEach((line, i) => {
+    const prev = lines[i - 1];
+    const next = lines[i + 1];
+    line.top = prev ? (prev.textBottom + line.textTop) / 2 : 0;
+    line.bottom = next ? (line.textBottom + next.textTop) / 2 : box.height;
+  });
+  return lines;
+}
+
+export function countChars(lines: MeasuredLine[]): number {
+  let total = 0;
+  for (const line of lines) total += line.chars.length;
+  return total;
+}
+
+export function textOf(lines: MeasuredLine[]): string {
+  let text = '';
+  for (const line of lines) for (const char of line.chars) text += char.ch;
+  return text;
+}
+
+// Line and index inside it of the character number `shown - 1`.
+export function locate(
+  lines: MeasuredLine[],
+  shown: number,
+): { line: MeasuredLine; index: number; lineStart: number } | null {
+  if (lines.length === 0) return null;
+  let rest = Math.max(shown, 1);
+  let start = 0;
+  let i = 0;
+  while (i < lines.length - 1 && rest > lines[i].chars.length) {
+    rest -= lines[i].chars.length;
+    start += lines[i].chars.length;
+    i++;
+  }
+  const line = lines[i];
+  return {
+    line,
+    index: Math.min(rest, line.chars.length) - 1,
+    lineStart: start,
+  };
+}
+
+export function revealPolygon(
+  lines: MeasuredLine[],
+  shown: number,
+  total: number,
+): string {
+  const at = shown > 0 ? locate(lines, Math.min(shown, total)) : null;
+  if (!at) return 'inset(0 100% 0 0)';
+  const x = round(at.line.chars[at.index].right);
+  const top = round(at.line.top);
+  const bottom = round(at.line.bottom);
+  return `polygon(0 0, 100% 0, 100% ${top}px, ${x}px ${top}px, ${x}px ${bottom}px, 0 ${bottom}px)`;
+}
+
+export function lineReveal(lines: MeasuredLine[], count: number): string {
+  if (count <= 0) return 'inset(0 100% 0 0)';
+  if (count >= lines.length) return 'inset(0)';
+  const bottom = round(lines[count - 1].bottom);
+  return `polygon(0 0, 100% 0, 100% ${bottom}px, 0 ${bottom}px)`;
+}
+
+export function popClip(inset: number, radius: string): string {
+  return `inset(${round(inset)}% round ${radius})`;
+}
+
+const TAG_LABELS = new Set(['H1', 'H2', 'H3', 'P', 'UL', 'A']);
+
+export function labelFor(el: HTMLElement): string {
+  const explicit = el.getAttribute('data-build-label');
+  if (explicit) return explicit;
+  if (el.querySelector('article')) return 'card';
+  if (el.querySelector('img') && (el.textContent ?? '').trim() === '') {
+    const r = el.getBoundingClientRect();
+    return `img ${Math.round(r.width)}x${Math.round(r.height)}`;
+  }
+  if (TAG_LABELS.has(el.tagName)) return el.tagName.toLowerCase();
+  const heading = el.querySelector('h1, h2, h3');
+  return heading ? heading.tagName.toLowerCase() : 'div';
+}
+
+const written = new WeakMap<HTMLElement, Map<string, string>>();
+
+export function setStyle(
+  el: HTMLElement,
+  prop: 'clip-path' | 'opacity',
+  value: string,
+): void {
+  let cache = written.get(el);
+  if (!cache) {
+    cache = new Map();
+    written.set(el, cache);
+  }
+  if (cache.get(prop) === value) return;
+  cache.set(prop, value);
+  el.style.setProperty(prop, value);
+}
+
+export function hide(el: HTMLElement): void {
+  el.setAttribute('data-build-fx', 'hidden');
+}
+
+export function live(el: HTMLElement): void {
+  el.removeAttribute('data-build-fx');
+}
+
+export function clear(el: HTMLElement): void {
+  el.removeAttribute('data-build-fx');
+  written.delete(el);
+  el.style.removeProperty('clip-path');
+  el.style.removeProperty('opacity');
+  el.style.removeProperty('pointer-events');
+  if (el.getAttribute('style') === '') el.removeAttribute('style');
+}
diff --git a/src/runtime/effect-timing.ts b/src/runtime/effect-timing.ts
new file mode 100644
index 0000000..f44bfeb
--- /dev/null
+++ b/src/runtime/effect-timing.ts
@@ -0,0 +1,187 @@
+import type { BuildStep, EffectName } from './types';
+
+// Pure, DOM-free effect timing: durations, seeded randomness and the phase
+// of every effect as a function of the step's local time in ms.
+
+export const SELECT_MS = 150;
+export const SKELETON_MS = 300;
+export const SKELETON_BARS_MS = 200;
+export const TYPE_CHAR_MS = 28;
+export const DECODE_MS = 350;
+export const LINE_MS = 40;
+export const POP_MS = 180;
+export const STAGGER_GAP_MS = 90;
+export const CARD_MS = 450;
+export const SCRAMBLE_FRAME_MS = 40;
+export const WINDOW_CALL_MAX = 29;
+export const SCRAMBLE_GLYPHS = '!<>-_\\/[]{}=+*^?#';
+
+const DOCK_START_MS = 250;
+const DOCK_CHAR_MS = 40;
+const DOCK_JITTER_MS = 10;
+const DOCK_PAUSE_MS = 100;
+
+const clamp = (value: number, min: number, max: number) =>
+  Math.min(Math.max(value, min), max);
+
+function ramp(t: number, from: number, to: number): number {
+  if (to <= from) return t >= to ? 1 : 0;
+  return clamp((t - from) / (to - from), 0, 1);
+}
+
+export const EFFECT_DURATION_MS: Record<
+  EffectName,
+  (step: BuildStep) => number | string
+> = {
+  select: () => SELECT_MS,
+  skeleton: () => SELECT_MS + SKELETON_MS,
+  'type-text': (s) =>
+    s.text === undefined ? 'needs text' : 150 + s.text.length * TYPE_CHAR_MS,
+  decode: (s) => (s.text === undefined ? 'needs text' : SELECT_MS + DECODE_MS),
+  'resolve-lines': (s) =>
+    s.count === undefined
+      ? 'needs count'
+      : SELECT_MS + SKELETON_BARS_MS + s.count * LINE_MS,
+  pop: () => SELECT_MS + POP_MS,
+  stagger: (s) =>
+    s.count === undefined
+      ? 'needs count'
+      : SELECT_MS + POP_MS + Math.max(s.count - 1, 0) * STAGGER_GAP_MS,
+  'build-card': () => CARD_MS,
+};
+
+export function hashSeed(text: string): number {
+  let hash = 0x811c9dc5;
+  for (let i = 0; i < text.length; i++) {
+    hash ^= text.charCodeAt(i);
+    hash = Math.imul(hash, 0x01000193);
+  }
+  return hash >>> 0;
+}
+
+export function createRng(seed: number): () => number {
+  let state = seed >>> 0;
+  return () => {
+    state = (state + 0x6d2b79f5) >>> 0;
+    let z = state;
+    z = Math.imul(z ^ (z >>> 15), z | 1);
+    z ^= z + Math.imul(z ^ (z >>> 7), z | 61);
+    return ((z ^ (z >>> 14)) >>> 0) / 4294967296;
+  };
+}
+
+export function estimateLines(text: string, charsPerLine: number): number {
+  let lines = 0;
+  for (const paragraph of text.split('\n\n')) {
+    lines += Math.max(1, Math.ceil(paragraph.length / charsPerLine));
+  }
+  return lines;
+}
+
+const dockSchedules = new Map<string, number[]>();
+
+function dockSchedule(command: string): number[] {
+  const cached = dockSchedules.get(command);
+  if (cached) return cached;
+  const length = command.length;
+  const rng = createRng(hashSeed(command));
+  const cumulative: number[] = [];
+  let sum = 0;
+  for (let k = 0; k < length; k++) {
+    let delay = DOCK_CHAR_MS + (rng() * 2 * DOCK_JITTER_MS - DOCK_JITTER_MS);
+    if (k > 0 && (command[k - 1] === '(' || command[k - 1] === ',')) {
+      delay += DOCK_PAUSE_MS;
+    }
+    sum += delay;
+    cumulative.push(sum);
+  }
+  const scale = sum > 0 ? (length * DOCK_CHAR_MS) / sum : 1;
+  const times = cumulative.map((c) => DOCK_START_MS + scale * c);
+  if (length > 0) times[length - 1] = DOCK_START_MS + length * DOCK_CHAR_MS;
+  dockSchedules.set(command, times);
+  return times;
+}
+
+export function typedChars(t: number, command: string): number {
+  const times = dockSchedule(command);
+  let count = 0;
+  while (count < times.length && times[count] <= t) count++;
+  return count;
+}
+
+export function truncateCall(call: string, max = WINDOW_CALL_MAX): string {
+  if (call.length <= max) return call;
+  const open = call.indexOf('(');
+  if (open !== -1 && call[open + 1] === '"') {
+    const head = call.slice(0, open + 2);
+    const tail = call.endsWith('")') ? '")' : ')';
+    const keep = max - head.length - 1 - tail.length;
+    if (keep >= 0) {
+      const body = call.slice(head.length, call.length - tail.length);
+      return `${head}${body.slice(0, keep)}…${tail}`;
+    }
+  }
+  return `${call.slice(0, max - 1)}…`;
+}
+
+export function typeCharsAt(localMs: number, length: number): number {
+  return clamp(Math.floor((localMs - SELECT_MS) / TYPE_CHAR_MS), 0, length);
+}
+
+export function decodeSettled(localMs: number, length: number): number {
+  return Math.floor(length * ramp(localMs, SELECT_MS, SELECT_MS + DECODE_MS));
+}
+
+export function decodeGlyphs(
+  text: string,
+  localMs: number,
+  seed: number,
+): string {
+  const settled = decodeSettled(localMs, text.length);
+  const rng = createRng(seed + Math.floor(localMs / SCRAMBLE_FRAME_MS) * 7919);
+  let out = '';
+  for (let i = 0; i < text.length; i++) {
+    if (i < settled || text[i] === ' ') out += text[i];
+    else out += SCRAMBLE_GLYPHS[Math.floor(rng() * SCRAMBLE_GLYPHS.length)];
+  }
+  return out;
+}
+
+export function resolveLinesAt(localMs: number, count: number): number {
+  return clamp(
+    Math.floor((localMs - SELECT_MS - SKELETON_BARS_MS) / LINE_MS),
+    0,
+    count,
+  );
+}
+
+export function popProgress(localMs: number): number {
+  return ramp(localMs, SELECT_MS, SELECT_MS + POP_MS);
+}
+
+export function popInset(p: number): number {
+  if (p < 0.7) return 10 - 14 * (p / 0.7);
+  return -4 * (1 - (p - 0.7) / 0.3);
+}
+
+export function staggerChildProgress(localMs: number, index: number): number {
+  return popProgress(localMs - index * STAGGER_GAP_MS);
+}
+
+export function cardPhases(localMs: number): {
+  select: number;
+  skeleton: boolean;
+  cover: boolean;
+  title: number;
+  summary: number;
+  tags: number;
+} {
+  return {
+    select: ramp(localMs, 0, 150),
+    skeleton: localMs >= 150 && localMs < 250,
+    cover: localMs >= 250,
+    title: ramp(localMs, 250, 400),
+    summary: ramp(localMs, 300, 420),
+    tags: ramp(localMs, 360, 450),
+  };
+}
