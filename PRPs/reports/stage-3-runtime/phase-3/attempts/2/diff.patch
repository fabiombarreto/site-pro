+/* Element effects */
+.sp-build-fx {
+  position: absolute;
+  top: 0;
+  left: 0;
+  width: 100%;
+  height: 0;
+  pointer-events: none;
+}
+
+.sp-select {
+  position: absolute;
+  top: 0;
+  left: 0;
+  box-sizing: border-box;
+  border: 1px solid var(--build-select);
+  background: var(--accent-glow);
+  pointer-events: none;
+}
+
+.sp-select-handle {
+  position: absolute;
+  width: 6px;
+  height: 6px;
+  background: var(--build-select);
+}
+
+.sp-select-handle:nth-child(1) {
+  top: -3px;
+  left: -3px;
+}
+
+.sp-select-handle:nth-child(2) {
+  top: -3px;
+  right: -3px;
+}
+
+.sp-select-handle:nth-child(3) {
+  bottom: -3px;
+  left: -3px;
+}
+
+.sp-select-handle:nth-child(4) {
+  bottom: -3px;
+  right: -3px;
+}
+
+.sp-select-label {
+  position: absolute;
+  bottom: 100%;
+  left: -1px;
+  padding: 0 var(--space-1);
+  font-family: var(--font-mono);
+  font-size: var(--mono-xs);
+  white-space: nowrap;
+  background: var(--build-select);
+  color: var(--on-accent);
+}
+
+.sp-skel {
+  position: absolute;
+  top: 0;
+  left: 0;
+  pointer-events: none;
+}
+
+.sp-skel-block {
+  position: absolute;
+  top: 0;
+  left: 0;
+  overflow: hidden;
+  background: var(--build-skeleton);
+  border-radius: var(--radius-sm);
+}
+
+.sp-skel-block::after {
+  content: '';
+  position: absolute;
+  inset: 0;
+  background: linear-gradient(
+    90deg,
+    transparent,
+    var(--build-shine),
+    transparent
+  );
+  animation: sp-skel-shimmer 1.4s linear infinite;
+}
+
+@keyframes sp-skel-shimmer {
+  from {
+    transform: translateX(-100%);
+  }
+  to {
+    transform: translateX(100%);
+  }
+}
+
+.sp-text-fx {
+  position: absolute;
+  top: 0;
+  left: 0;
+  pointer-events: none;
+}
+
+.sp-caret {
+  position: absolute;
+  top: 0;
+  left: 0;
+  width: 2px;
+  background: var(--accent-fg);
+  pointer-events: none;
+}
+
+.sp-scramble {
+  position: absolute;
+  top: 0;
+  left: 0;
+  white-space: pre;
+  color: var(--accent-fg);
+  pointer-events: none;
+}
+
 @media (prefers-reduced-motion: reduce) {
   .sp-cursor {
     animation: none;
   }
+
+  .sp-skel-block::after {
+    animation: none;
+  }
 }
 
